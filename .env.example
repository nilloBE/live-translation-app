AZURE_LOCATION=westeurope
AZURE_RESOURCE_GROUP=rg-live-translation-dev
SPEECH_RESOURCE_NAME=speech-live-translation-dev
# Optional: F0 or S0. Blank preserves an existing SKU; new resources default to paid S0.
# Precedence: -SpeechSku > real environment > root .env > existing SKU > S0.
# F0 supports one concurrent speaker only. Leaving F0 here requests it on each deploy.
SPEECH_SKU=
ACR_NAME=acrlivetranslationdev
CONTAINER_APP_ENV_NAME=env-live-translation-dev
CONTAINER_APP_NAME=api-live-translation-dev
STATIC_WEB_APP_NAME=web-live-translation-dev

# Required privately for a new backend; never commit a real value.
# Blank preserves an existing Container App secret. A supplied value sets/rotates it.
# Secrets are installed before the serving revision and are never printed.
ADMIN_API_KEY=
