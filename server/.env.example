NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
SPEECH_REGION=westeurope
SPEECH_ENDPOINT=https://speech-live-translation-dev.cognitiveservices.azure.com

# Shared secret for the /api/admin/* endpoints and the /admin realtime namespace.
# Not an Azure credential - just gates access to the monitoring dashboard.
# Pick any non-guessable string for local dev; deploy-azure.ps1 generates one for production.
ADMIN_API_KEY=local-dev-admin-key
